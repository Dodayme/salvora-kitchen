{
  "name": "salvora-kitchen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "predev": "node scripts/ensure-development-database.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:client": "node scripts/check-client-boundary.mjs",
    "test": "vitest run",
    "test:http": "node scripts/verify-http.mjs",
    "test:http:auth": "tsx scripts/verify-auth-http.mjs",
    "test:http:catalog": "tsx scripts/verify-catalog-http.mjs",
    "test:http:buyer": "tsx scripts/verify-buyer-http.mjs",
    "test:http:webhook": "tsx scripts/verify-webhook-http.mjs",
    "test:http:reconcile": "tsx scripts/verify-reconciliation-http.mjs",
    "test:midtrans:sandbox": "tsx scripts/verify-midtrans-sandbox.mjs",
    "payments:reconcile": "tsx scripts/reconcile-payments.mjs",
    "test:automation:launcher": "node scripts/verify-payment-launcher.mjs",
    "test:automation:scheduler": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/payment-scheduler-safety.ps1",
    "test:automation:worker": "node --test tests/payment-worker.test.mjs",
    "test:db": "tsx scripts/test-database.mjs",
    "check:env": "tsx scripts/check-env.ts",
    "check:payments:runtime": "node --import tsx scripts/payment-runtime-probe.mjs",
    "db:local": "node scripts/local-postgres.mjs",
    "db:generate": "tsx scripts/database.mjs generate",
    "db:validate": "tsx scripts/database.mjs validate",
    "db:migrate": "tsx scripts/database.mjs migrate",
    "db:migrate:test": "tsx scripts/database.mjs migrate test",
    "db:status": "tsx scripts/database.mjs status",
    "db:seed": "tsx scripts/database.mjs seed",
    "db:seed:test": "tsx scripts/database.mjs seed test",
    "db:admin": "tsx scripts/create-admin.ts",
    "db:backup": "tsx scripts/backup-database.mjs",
    "db:check": "tsx scripts/check-database.ts"
  },
  "dependencies": {
    "@next/env": "16.4.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.31",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
