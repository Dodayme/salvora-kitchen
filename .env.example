# Placeholder only. Create new credentials for Salvora; never copy LanggananKu .env.
# Create the database separately in BE-02. No fallback connection is provided.
DATABASE_URL="postgresql://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/salvora_kitchen_dev"
TEST_DATABASE_URL="postgresql://REPLACE_TEST_USER:REPLACE_TEST_PASSWORD@localhost:5432/salvora_kitchen_test"
# Optional, dedicated shadow database for future migrate dev:
# SHADOW_DATABASE_URL="postgresql://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/salvora_kitchen_shadow"
AUTH_SECRET="REPLACE_WITH_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
# Token creation works locally with both Sandbox keys above.
# Webhook handler is available in BE-09. Set a reachable HTTPS webhook URL
# for deployment; a temporary test override does not establish hosting readiness.
MIDTRANS_WEBHOOK_URL=""
# Approved O-01: must match the 60-minute order/reservation policy.
PAYMENT_EXPIRY_MINUTES="60"
# SESSION_TTL_DAYS is fixed at 7 in the current foundation.
# Local photos: BE-04. Local Windows Task Scheduler: BE-10, no public cron secret.
# Demo hosting, persistent deployment volume and server scheduler still need selection.
# Optional internal CLI provisioning only; do not expose to browser or commit real values:
# SEED_ADMIN_EMAIL="REPLACE_ADMIN_EMAIL"
# SEED_ADMIN_PASSWORD="REPLACE_WITH_NEW_SECRET"
# SALVORA_POSTGRES_BIN="C:/Program Files/PostgreSQL/18/bin"
# Local development uses .local/uploads/product-photos; tests use a separate directory.
# Production upload requires an absolute private path on a persistent mounted volume:
# PRODUCT_PHOTO_STORAGE_DIR="REPLACE_ABSOLUTE_PERSISTENT_PRIVATE_DIRECTORY"
# PRODUCT_PHOTO_STORAGE_PERSISTENT="true"
